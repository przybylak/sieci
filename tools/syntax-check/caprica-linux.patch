+namespace caprica { namespace fmt_detail {
+// Non-MSVC: std::string / std::string_view / identifier_ref can't go through
+// C varargs into %s (different layouts), so turn them into C strings first.
+template <typename T>
+struct has_to_string_view {
+  template <typename U>
+  static auto test(int) -> decltype(std::declval<const U&>().to_string_view(), std::true_type {});
+  template <typename>
+  static std::false_type test(...);
+  static constexpr bool value = decltype(test<T>(0))::value;
+};
+template <typename T>
+inline auto conv(T&& v) {
+  using D = std::decay_t<T>;
+  if constexpr (std::is_same_v<D, std::string> || std::is_same_v<D, std::string_view>)
+    return std::string(v);
+  else if constexpr (has_to_string_view<D>::value)
+    return std::string(v.to_string_view());
+  else
+    return D(v);
+}
+inline const char* pass(const std::string& s) { return s.c_str(); }
+template <typename T>
+inline T pass(const T& v) { return v; }
+}}
